                <ANNOTATION_VALUE>далее я хотел бы спросить про собственно почему ты выбрал именно лингвистику?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
